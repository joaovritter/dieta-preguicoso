# Copie para .env (dentro de backend/) e preencha. NUNCA comite o .env.
# Só para rodar o backend fora do Docker, com `npm run dev`. Para a stack
# completa via `docker compose up -d --build`, use o .env da raiz do repo.

# --- Banco ---
# Aponta para o Postgres do docker compose exposto em localhost (veja
# docker-compose.yml — pode ser preciso publicar a porta 5432 do serviço
# `postgres`) ou para um Postgres local próprio. Usuário/senha/db iguais
# aos do .env da raiz.
DATABASE_URL=postgres://dieta:troque-esta-senha@localhost:5432/dieta

# --- Autenticação ---
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-por-um-hex-de-64-caracteres
JWT_EXPIRACAO=30d

# --- IA ---
# Qual serviço interpreta foto, áudio e texto: gemini ou openai.
# Só a chave do escolhido é exigida; a outra pode ficar em branco.
IA_PROVEDOR=gemini

# Gemini (tem camada gratuita com limite por minuto e por dia).
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash

# OpenAI (paga desde o primeiro token). Só precisa com IA_PROVEDOR=openai.
OPENAI_API_KEY=
OPENAI_MODEL_TEXTO=gpt-4o
OPENAI_MODEL_VISAO=gpt-4o
OPENAI_MODEL_AUDIO=whisper-1

# --- App ---
PORT=3001
DIR_UPLOADS=./uploads
TIMEZONE_PADRAO=America/Sao_Paulo
# Dias que fotos e áudios ficam no disco. 0 = apaga na primeira limpeza após o registro.
RETENCAO_MIDIA_DIAS=30
# true = qualquer pessoa cria conta.
PERMITIR_CADASTRO=true
# Sem proxy na frente em dev local.
TRUST_PROXY=0
