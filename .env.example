# Copie para .env e preencha. NUNCA comite o .env.
# Gere segredos com: openssl rand -hex 32

# --- Banco ---
POSTGRES_USER=dieta
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=dieta

# --- Autenticação ---
JWT_SECRET=troque-por-um-hex-de-64-caracteres
JWT_EXPIRACAO=30d

# --- IA ---
# Qual serviço interpreta foto, áudio e texto: gemini ou openai.
# Só a chave do escolhido é exigida; a outra pode ficar em branco.
IA_PROVEDOR=gemini

# Gemini (tem camada gratuita com limite por minuto e por dia).
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Confira os modelos disponíveis na sua conta antes de trocar este nome.
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (paga desde o primeiro token). Só precisa com IA_PROVEDOR=openai.
OPENAI_API_KEY=
OPENAI_MODEL_TEXTO=gpt-4o
OPENAI_MODEL_VISAO=gpt-4o
OPENAI_MODEL_AUDIO=whisper-1

# --- App ---
# Porta exposta na VPS (acesso por http://IP:PORTA_PUBLICA)
PORTA_PUBLICA=8080
TIMEZONE_PADRAO=America/Sao_Paulo
# Dias que fotos e áudios ficam no disco. 0 = apaga na primeira limpeza após o registro.
RETENCAO_MIDIA_DIAS=30
# true = qualquer pessoa cria conta (a rede social precisa disso: seus amigos
# entram por aqui). Mude para false quando quiser trancar o servidor.
PERMITIR_CADASTRO=true
# Proxies na frente da API: 1 = só o nginx do compose. Use 2 com o perfil `https`
# abaixo, senão o limite de tentativas de login conta todo mundo no mesmo balde.
TRUST_PROXY=1

# --- HTTPS (perfil `https`: docker compose --profile https up -d) ---
# Domínio que aponta para esta VPS; é para ele que o Caddy pede o certificado.
DOMINIO=dieta.trainna.com.br
# Em que endereço a porta do app escuta. Com HTTPS ligado use 127.0.0.1: só o
# Caddy alcança o app e a PORTA_PUBLICA some da internet. Sem HTTPS, 0.0.0.0,
# que é como você acessa por http://IP:8080.
BIND_PUBLICO=0.0.0.0

# --- Só para rodar o backend fora do Docker (npm run dev) ---
# DATABASE_URL=postgres://dieta:senha@localhost:5432/dieta
# PORT=3001
# DIR_UPLOADS=./uploads
